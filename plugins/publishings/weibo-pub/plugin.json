{
    "name": "weibo-pub",
    "kind": "publish",
    "entry": "./src/index.ts",
    "check": "./src/profile-check.ts",
    "version": "1.0.0",
    "description": "post and 头条文章 article via a script browser transport (ts-browser-automation), draft by default",
    "browserSession": {
        "profileName": "weibo",
        "homeUrl": "https://weibo.com"
    },
    "publishing": {
        "defaultProfile": "article",
        "profiles": {
            "article": {
                "format": "article",
                "locale": "zh",
                "modes": {
                    "draft": {
                        "metadata": {
                            "operation": "article",
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "operation": "article",
                            "publishStatus": "public"
                        }
                    }
                }
            },
            "post": {
                "format": "short-post",
                "locale": "zh",
                "modes": {
                    "live": {
                        "metadata": {
                            "operation": "post",
                            "publishStatus": "public"
                        }
                    }
                }
            }
        }
    }
}
