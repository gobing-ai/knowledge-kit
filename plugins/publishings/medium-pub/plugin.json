{
    "name": "medium-pub",
    "kind": "publish",
    "entry": "./src/index.ts",
    "check": "./src/profile-check.ts",
    "version": "1.0.0",
    "description": "Publish plugin for Medium (medium.com): integration-token REST API when a token is configured, otherwise a headed script browser rail that fails closed on Cloudflare challenges",
    "browserSession": {
        "profileName": "medium",
        "homeUrl": "https://medium.com/new-story"
    },
    "publishing": {
        "defaultProfile": "article",
        "profiles": {
            "article": {
                "format": "article",
                "locale": "en",
                "modes": {
                    "draft": {
                        "metadata": {
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "publishStatus": "public"
                        }
                    }
                }
            }
        }
    }
}
