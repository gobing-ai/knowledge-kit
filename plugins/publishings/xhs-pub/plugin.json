{
    "name": "xhs-pub",
    "kind": "publish",
    "entry": "./src/index.ts",
    "check": "./src/profile-check.ts",
    "version": "1.0.0",
    "description": "Publish plugin for Xiaohongshu (xhs): one creator console, four validated operations (\u4e0a\u4f20\u56fe\u6587 \u226418 images | \u4e0a\u4f20\u89c6\u9891 | \u5199\u957f\u6587 | \u53d1\u64ad\u5ba2 audio+cover) saved as a draft via \u6682\u5b58\u79bb\u5f00 or published live via \u53d1\u5e03, over the Playwright script transport",
    "browserSession": {
        "profileName": "xhs",
        "homeUrl": "https://creator.xiaohongshu.com/publish/publish"
    },
    "publishing": {
        "defaultProfile": "note",
        "profiles": {
            "note": {
                "format": "short-note",
                "locale": "zh",
                "requires": {
                    "cover": true,
                    "orderedImages": true
                },
                "limits": {
                    "title": {
                        "max": 20,
                        "unit": "xiaohongshu_title_weighted"
                    },
                    "body": {
                        "max": 1000,
                        "unit": "unicode_code_points"
                    }
                },
                "modes": {
                    "draft": {
                        "metadata": {
                            "operation": "\u4e0a\u4f20\u56fe\u6587",
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "operation": "\u4e0a\u4f20\u56fe\u6587",
                            "publishStatus": "public"
                        }
                    }
                }
            },
            "video": {
                "format": "video",
                "locale": "zh",
                "limits": {
                    "title": {
                        "max": 20,
                        "unit": "xiaohongshu_title_weighted"
                    }
                },
                "modes": {
                    "draft": {
                        "metadata": {
                            "operation": "\u4e0a\u4f20\u89c6\u9891",
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "operation": "\u4e0a\u4f20\u89c6\u9891",
                            "publishStatus": "public"
                        }
                    }
                }
            }
        }
    }
}
