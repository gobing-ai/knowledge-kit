{
    "name": "xhs-pub",
    "kind": "publish",
    "entry": "./src/index.ts",
    "check": "./src/profile-check.ts",
    "version": "1.0.0",
    "description": "Publish plugin for Xiaohongshu (xhs): one creator console, four validated operations (上传图文 ≤18 images | 上传视频 | 写长文 | 发播客 audio+cover) saved as a draft via 暂存离开 or published live via 发布, over the Playwright script transport",
    "browserSession": {
        "profileName": "xhs",
        "homeUrl": "https://creator.xiaohongshu.com/publish/publish"
    },
    "publishing": {
        "defaultProfile": "note",
        "profiles": {
            "note": {
                "format": "short-note",
                "locale": "zh",
                "requires": {
                    "cover": true,
                    "orderedImages": true
                },
                "limits": {
                    "title": {
                        "max": 20,
                        "unit": "xiaohongshu_title_weighted"
                    },
                    "body": {
                        "max": 1000,
                        "unit": "unicode_code_points"
                    }
                },
                "modes": {
                    "draft": {
                        "metadata": {
                            "operation": "上传图文",
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "operation": "上传图文",
                            "publishStatus": "public"
                        }
                    }
                }
            }
        }
    }
}
