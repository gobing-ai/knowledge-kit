{
    "name": "x-pub",
    "kind": "publish",
    "entry": "./src/index.ts",
    "check": "./src/profile-check.ts",
    "version": "1.0.0",
    "description": "post via official tweets API; article via script browser transport (ts-browser-automation)",
    "browserSession": {
        "profileName": "x",
        "homeUrl": "https://x.com/compose/articles"
    },
    "publishing": {
        "defaultProfile": "post",
        "profiles": {
            "post": {
                "format": "short-post",
                "locale": "en",
                "limits": {
                    "body": {
                        "max": 280,
                        "unit": "weighted"
                    }
                },
                "modes": {
                    "live": {
                        "metadata": {
                            "operation": "post"
                        }
                    }
                }
            },
            "article": {
                "format": "article",
                "locale": "en",
                "modes": {
                    "draft": {
                        "metadata": {
                            "operation": "article",
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "operation": "article",
                            "publishStatus": "public"
                        }
                    }
                }
            },
            "article-zh": {
                "format": "article",
                "locale": "zh",
                "modes": {
                    "draft": {
                        "metadata": {
                            "operation": "article",
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "operation": "article",
                            "publishStatus": "public"
                        }
                    }
                }
            }
        }
    }
}
