{
    "name": "wechatmp-pub",
    "kind": "publish",
    "entry": "./src/index.ts",
    "check": "./src/profile-check.ts",
    "version": "1.0.0",
    "description": "Publish plugin for the WeChat MP console via ts-browser-automation: draft-box first (ADR-022), headed publish behind a session preflight",
    "browserSession": {
        "profileName": "wechatmp",
        "homeUrl": "https://mp.weixin.qq.com/"
    },
    "publishing": {
        "defaultProfile": "article",
        "profiles": {
            "article": {
                "format": "wechat-article",
                "locale": "zh",
                "requires": {
                    "cover": true
                },
                "limits": {
                    "title": {
                        "max": 64,
                        "unit": "unicode_code_points"
                    }
                },
                "modes": {
                    "draft": {
                        "metadata": {
                            "operation": "文章",
                            "publishStatus": "draft"
                        }
                    },
                    "live": {
                        "metadata": {
                            "operation": "文章",
                            "publishStatus": "public"
                        }
                    }
                }
            }
        }
    }
}
