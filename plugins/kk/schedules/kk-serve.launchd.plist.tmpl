<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- kk-serve — keeps the knowledge-kit Spur server alive whenever this user is logged in.

     WHY the keepalive is not optional: the daily job `kk-daily-ai-voice` (cron `30 4 * * *`) is
     enqueued by the job worker that lives INSIDE `spur self serve` (`.spur/config.yaml`
     `bootstrap.scheduler`). On 2026-10-12 that process was SIGTERM'd at 00:17 local and not
     restarted until 10:00, so the 04:30 tick never fired and the day produced no episode at all —
     no workspace, no ledger row, no run record. `crontab -l` is empty and nothing else supervises
     it, so an unsupervised server is a silently missed day. RunAtLoad brings it up at login;
     KeepAlive restarts it on crash; ThrottleInterval bounds the restart rate.

     Rendered by `kk schedule render kk-serve --platform launchd --repo <checkout>`; kk never
     installs it. Operator action (plugins/kk/README.md §Schedule):

         mkdir -p "$PWD/.works/spur-serve"
         kk schedule render kk-serve --platform launchd --repo "$PWD" \
           > ~/Library/LaunchAgents/ai.gobing.spur-serve.plist
         launchctl bootout gui/$(id -u)/ai.gobing.spur-serve 2>/dev/null || :
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.gobing.spur-serve.plist

     launchd only, deliberately: cron has no keepalive semantics, so a cron render is refused
     rather than rendered half-useful. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.gobing.spur-serve</string>
    <!-- Absolute `Program` for the same reason as ai.gobing.kk-collect: launchd resolves a RELATIVE
         ProgramArguments[0] with its own _PATH_STDPATH (/usr/bin:/bin:/usr/sbin:/sbin) before the
         job environment exists, so a bare `spur` fails with posix_spawn error 0x2 no matter what
         PATH this plist sets (man launchd.plist: ProgramArguments). -->
    <key>Program</key>
    <string>{{home}}/.bun/bin/spur</string>
    <key>ProgramArguments</key>
    <array>
        <string>spur</string>
        <string>self</string>
        <string>serve</string>
        <string>--cwd</string>
        <string>{{repo}}</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>3003</string>
        <string>--no-open</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{repo}}</string>
    <!-- The environment block is load-bearing three times over:
           - PATH — launchd starts with /usr/bin:/bin:/usr/sbin:/sbin and the scheduler's job worker
             runs its commands through /bin/sh -c, so bare `spur`, `kk`, `jq` and `bun` must resolve.
           - NODE_PATH — the module root carrying `@gobing-ai/spur`. Project decision catalogs
             (`decisions.paths` → `plugins/kk/decisions`) declare `$schema:
             "@gobing-ai/spur/schemas/decision-catalog.schema.json"`, and Bun's resolver does not
             search the global install, so WITHOUT this every registered catalog fails to load: kk
             answers `Decision catalog … Cannot find package '@gobing-ai/spur'` (2026-11-19: a whole
             `kk-collect` tick lost its labels and the next 04:30 run lost its `kk-safety-verdict`
             row, which the gate read as a refusal) and spur's `decide` action silently loads ZERO
             project catalogs. `kk schedule render` binds the path from the `spur` on PATH that the
             `Program` below names; render from a shell that has it.
           - TYPESAFE_API_KEY — spur keeps the decision-maker credential env-only, and a server
             started from launchd inherits nothing from the operator's shell; without the key every
             `typesafe`-routed decision (kk-item-china-politics, -sensitivity, -audience) falls back
             fail-closed (china-politics = 3), which empties the ai-news extract pool and makes the
             daily run close as no-content. `kk schedule render` binds it from the environment it
             runs in, so render from a shell that has the key.

         The hand-installed plist also bound TYPESAFE_BASE_URL; it is deliberately not part of the
         shipped template (task 0265 decision D2) — no placeholder exists and no artifact needs it. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{home}}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_PATH</key>
        <string>{{spur_modules}}</string>
        <key>TYPESAFE_API_KEY</key>
        <string>{{typesafe_api_key}}</string>
    </dict>
    <!-- launchd opens these itself, but never creates the parent: `mkdir -p .works/spur-serve` first. -->
    <key>StandardOutPath</key>
    <string>{{repo}}/.works/spur-serve/serve.log</string>
    <key>StandardErrorPath</key>
    <string>{{repo}}/.works/spur-serve/serve.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
