<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- kk-collect — standalone 6-hourly collection (04:00/10:00/16:00/22:00 local) into the kk store.

     Rendered by `kk schedule render kk-collect --platform launchd --repo <checkout>`; kk never
     installs it. Operator action (plugins/kk/README.md §Schedule):

         kk schedule render kk-collect --platform launchd --repo "$PWD" \
           > ~/Library/LaunchAgents/ai.gobing.kk-collect.plist
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.gobing.kk-collect.plist

     StartCalendarInterval fires at 04:00/10:00/16:00/22:00 local wall-clock time (6 h cadence);
     hours the machine is asleep through coalesce into one run at wake (launchd.plist(5)), where cron
     would skip. The engine runs one node at a time and `kk store lock` is the single-flight guard,
     so overlap is answered with `skipped`, never with two collectors. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.gobing.kk-collect</string>
    <!-- launchd resolves a RELATIVE ProgramArguments[0] with its own _PATH_STDPATH
         (/usr/bin:/bin:/usr/sbin:/sbin) before the job environment exists, so a bare `spur` fails with
         posix_spawn error 0x2 no matter what PATH this plist sets (man launchd.plist: ProgramArguments).
         `Program` is the absolute executable launchd execs; ProgramArguments keeps R6's frozen argv. -->
    <key>Program</key>
    <string>{{home}}/.bun/bin/spur</string>
    <key>ProgramArguments</key>
    <array>
        <string>spur</string>
        <string>workflow</string>
        <string>run</string>
        <string>plugins/kk/workflows/kk-collect.yaml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{repo}}</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>4</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>16</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <!-- The job environment applies only AFTER exec, so it is not what resolves `spur` above —
         it is what the workflow's own children need (`kk`, `jq`, `bun` are all `#!/usr/bin/env bun`
         or PATH-resolved). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{home}}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>{{repo}}/.works/kk-collect/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>{{repo}}/.works/kk-collect/launchd.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
