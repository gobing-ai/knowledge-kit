{
    "name": "knowledge-kit",
    "type": "module",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*",
            "plugins/ingestions/*",
            "plugins/generations/*",
            "plugins/publishings/*"
        ],
        "catalog": {
            "@gobing-ai/ts-db": "^0.4.35",
            "@gobing-ai/ts-infra": "^0.4.35",
            "@gobing-ai/ts-runtime": "^0.4.35",
            "@gobing-ai/ts-utils": "^0.4.35"
        }
    },
    "scripts": {
        "prepare": "lefthook install",
        "dev": "bun run --filter './apps/*' --filter './packages/*' dev",
        "build": "bun run --filter './apps/*' --filter './packages/*' build",
        "test": "NODE_ENV=test bun test --dots --coverage --coverage-dir=.coverage --coverage-reporter=lcov --coverage-reporter=text apps packages plugins",
        "test:full": "NODE_ENV=test bun test --coverage --coverage-dir=.coverage --coverage-reporter=lcov --coverage-reporter=text apps packages plugins",
        "test-pre-check": "spur rule run --preset recommended-pre-check --fail-on warning",
        "test-post-check": "spur rule run --preset recommended-post-check --fail-on warning",
        "test-pre-check:full": "spur rule run --preset recommended-pre-check --fail-on warning --verbose",
        "test-post-check:full": "spur rule run --preset recommended-post-check --fail-on warning --verbose",
        "spur-check": "bun run lint && bun run test-pre-check && bun run test && bun run test-post-check",
        "spur-check:full": "bun run lint && bun run test-pre-check:full && bun run test:full && bun run test-post-check:full",
        "typecheck": "bun run --filter './apps/*' --filter './packages/*' --filter './plugins/ingestions/*' --filter './plugins/generations/*' --filter './plugins/publishings/*' typecheck",
        "lint": "biome check . && bun run typecheck",
        "format": "biome check . --write",
        "autofix": "bun run format && bun run typecheck",
        "bump-ver": "bun scripts/release.ts bump-ver",
        "drop-tags": "bun scripts/release.ts drop-tags",
        "check": "bun run lint && bun run test",
        "check:full": "bun run lint && bun run test:full"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.5",
        "@gobing-ai/ts-utils": "catalog:",
        "@types/bun": "1.3.14"
    }
}
