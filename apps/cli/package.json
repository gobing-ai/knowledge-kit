{
    "name": "@gobing-ai/knowledge-kit",
    "version": "0.1.5",
    "description": "An ingest → create → publish content pipeline CLI (Bun).",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gobing-ai/knowledge-kit.git"
    },
    "homepage": "https://github.com/gobing-ai/knowledge-kit#readme",
    "bugs": {
        "url": "https://github.com/gobing-ai/knowledge-kit/issues"
    },
    "keywords": [
        "cli",
        "content-pipeline",
        "content-creation",
        "publishing",
        "ingestion",
        "plugins",
        "ai",
        "bun",
        "typescript"
    ],
    "author": "Robin Min <minlongbing@gmail.com>",
    "license": "Apache-2.0",
    "engines": {
        "bun": ">=1.4.3"
    },
    "type": "module",
    "bin": {
        "kk": "./dist/index.js",
        "knowledge-kit": "./dist/index.js"
    },
    "files": [
        "dist/",
        "plugins/",
        ".claude-plugin/"
    ],
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun run src/index.ts",
        "build": "bun build src/index.ts --target=bun --outdir=dist --external playwright --external @gobing-ai/ts-ai-decision",
        "build:bundle": "bun run build && bun run ../../scripts/bundle-plugins.ts && bun run ../../scripts/build-board.ts",
        "prepack": "bun run build:bundle",
        "test": "NODE_ENV=test bun test --coverage --coverage-dir=.coverage --reporter=dots",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@gobing-ai/kk-core": "workspace:*",
        "@gobing-ai/kk-store": "workspace:*",
        "@gobing-ai/publish-harness": "workspace:*",
        "@gobing-ai/ts-ai-decision": "catalog:",
        "@gobing-ai/ts-infra": "catalog:",
        "@gobing-ai/ts-runtime": "catalog:",
        "@gobing-ai/ts-utils": "catalog:",
        "commander": "15.0.0",
        "playwright": "catalog:",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@gobing-ai/kk-board": "workspace:*",
        "@types/bun": "1.4.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
